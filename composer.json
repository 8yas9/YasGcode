{
    "name": "yasksalim/magic-generator",
    "description": "An advanced CRUD code generator for Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Yas K Salim (Yas K Salim)",
            "email": "yasksalim@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "livewire/livewire": "^3.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "suggest": {
        "doctrine/dbal": "Required for precise column type detection. Install with: composer require doctrine/dbal"
    },
    "autoload": {
        "psr-4": {
            "YasKSalim\\MagicGenerator\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "YasKSalim\\MagicGenerator\\MagicGeneratorServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
