{
    "name": "yasksalim/magic-generator",
    "description": "An advanced CRUD code generator for Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Yas K Salim (Yas K Salim)",
            "email": "yasksalim@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "livewire/livewire": "^3.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "phpstan/phpstan": "^1.11",
        "friendsofphp/php-cs-fixer": "^3.40",
        "nunomaduro/collision": "^7.0|^8.0",
        "pestphp/pest": "^2.0|^3.0"
    },
    "suggest": {
        "doctrine/dbal": "Required for precise column type detection. Install with: composer require doctrine/dbal"
    },
    "autoload": {
        "psr-4": {
            "YasKSalim\\MagicGenerator\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "YasKSalim\\MagicGenerator\\MagicGeneratorServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "pest",
        "test-coverage": "pest --coverage",
        "analyse": "phpstan analyse",
        "style-check": "php-cs-fixer fix --dry-run --diff",
        "style-fix": "php-cs-fixer fix",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ]
    }
}
